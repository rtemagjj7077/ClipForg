<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Primary Gold Button -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="#E5B84A" />
        <Setter Property="Foreground" Value="#101112" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="#F0C65D" />
    </Style>

    <!-- Secondary Outline Button -->
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="#1B1D20" />
        <Setter Property="Foreground" Value="#F1F1EF" />
        <Setter Property="BorderBrush" Value="#292C31" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style Selector="Button.secondary:pointerover">
        <Setter Property="Background" Value="#25282D" />
    </Style>

    <!-- Ghost Button -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#8A8E94" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
        <Setter Property="Background" Value="#202226" />
        <Setter Property="Foreground" Value="#F1F1EF" />
    </Style>

    <!-- Clip Card Hover (120ms transition, 1.01 subtle scale) -->
    <Style Selector="Border.clipCard">
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.clipCard:pointerover">
        <Setter Property="Background" Value="#1E2024" />
        <Setter Property="BorderBrush" Value="#3A3E45" />
        <Setter Property="RenderTransform" Value="scale(1.01)" />
    </Style>
</Styles>
